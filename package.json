{
  "name": "sportabzeichen-vorerfassung",
  "private": true,
  "version": "0.1.0",
  "description": "Vorerfassung für das Deutsche Sportabzeichen (regulär und für Menschen mit Behinderung) als eine einzige HTML-Datei mit lokaler Speicherung.",
  "license": "AGPL-3.0-only",
  "author": "Tobias Heinrich",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 5178 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5178 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import:archivieren": "node tools/import-archivieren.ts",
    "build:hosted": "tsc --noEmit && vite build --mode hosted",
    "icons": "node tools/icons.ts",
    "hochladen": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../private/Auslieferung/upload.ps1 -Projekt . -Ziel app",
    "tester": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../private/Auslieferung/tester.ps1 -Projekt . -Ziel app",
    "katalog:lokal": "node tools/katalog-lokal.ts"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.12",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.12"
  }
}
