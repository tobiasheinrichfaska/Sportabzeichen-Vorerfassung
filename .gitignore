# Dependencies & build output (dist-hosted/ carries the local limit tables)
node_modules/
dist/
dist-hosted/
coverage/

# Upload tool: tester list and generated access files of the hosted app (private/Auslieferung)
deploy/.local/

# Project-bound scratch area (workspace rule: never use global temp)
.tmp/

# Delivered material (official PDFs, Mustervorlagen, real participant lists) — never committed
import/
# import/ is an inbox: after each processing its content moves here (npm run import:archivieren)
archiv/

# Saved workbooks contain personal and health data (Behinderungsklasse) — never committed
*.sportabzeichen.json

# Limit tables and class details from DOSB/DBS/federation documents — rights stay with them
catalog/local/

# Private companion repo Sportabzeichen-Vorerfassung-privat, copied 1:1 over this checkout (with
# catalog/local/, archiv/ and .tmp/ above): verification record and rights research, the converter
# of the platform data and its tests — never in this public repo
docs/privat/
tools/localCatalog.ts
tools/katalog-lokal.ts
tests/tools/localCatalog.test.ts

# Data files (workspace checklist private → public)
*.xlsx
*.csv
*.db
*.sqlite*
*.log

# Local environment / editor
.env
.env.*
.vscode/
.idea/
*.wsb

# OS junk
.DS_Store
Thumbs.db
desktop.ini
